@page "/admin"
@attribute [Authorize(Roles = "admin")]
@inject WorkReservationWeb.Web.Services.ReservationAdminApiClient AdminApiClient
@using Microsoft.AspNetCore.Components.Forms
@using WorkReservationWeb.Shared.Contracts

<PageTitle>Admin</PageTitle>

<h1>Admin</h1>

@if (AdminApiClient.UsesConfiguredClientPrincipal)
{
	<p class="alert alert-warning">
		Local development mode is injecting a configured admin principal header for these requests.
	</p>
}

<section class="mb-5">
	<h2 class="h4">Create Or Update Service Offer</h2>

	@if (!string.IsNullOrWhiteSpace(serviceOffersErrorMessage))
	{
		<p class="text-danger">@serviceOffersErrorMessage</p>
	}

	@if (serviceOffers.Count > 0)
	{
		<div class="mb-3">
			<label for="existingServiceOffer" class="form-label">Existing service offer</label>
			<select id="existingServiceOffer" class="form-select" @bind="selectedServiceOfferId" @bind:after="OnSelectedServiceOfferChangedAsync">
				<option value="">Create new service offer</option>
				@foreach (var serviceOffer in serviceOffers)
				{
					<option value="@serviceOffer.Id">@serviceOffer.Title (@(serviceOffer.Active ? "Active" : "Inactive"))</option>
				}
			</select>
		</div>
	}

	<div class="mb-3">
		<label for="serviceTitle" class="form-label">Title</label>
		<input id="serviceTitle" class="form-control" @bind="serviceTitle" />
	</div>

	<div class="mb-3">
		<label for="serviceDescription" class="form-label">Description</label>
		<textarea id="serviceDescription" class="form-control" @bind="serviceDescription"></textarea>
	</div>

	<div class="mb-3">
		<label for="serviceBasePrice" class="form-label">Base price</label>
		<input id="serviceBasePrice" type="number" step="0.01" class="form-control" @bind="serviceBasePrice" />
	</div>

	<div class="mb-3">
		<label for="serviceImageUpload" class="form-label">Images</label>
		<InputFile id="serviceImageUpload" class="form-control" OnChange="UploadImageAsync" accept="image/*" disabled="@(isSavingServiceOffer || isUploadingImage)" />
		<div class="form-text">Upload image files up to 5 MB each. Uploaded images are added to the current service offer.</div>
	</div>

	@if (!string.IsNullOrWhiteSpace(imageUploadMessage))
	{
		<p class="mb-3 @imageUploadMessageClass">@imageUploadMessage</p>
	}

	@if (serviceImageUrls.Count == 0)
	{
		<p class="text-muted">No images attached yet.</p>
	}
	else
	{
		<div class="row g-3 mb-3">
			@foreach (var imageUrl in serviceImageUrls)
			{
				<div class="col-sm-6 col-lg-4">
					<div class="card h-100">
						<img src="@imageUrl" class="card-img-top" alt="Service offer image" style="height: 180px; object-fit: cover;" />
						<div class="card-body d-flex flex-column gap-2">
							<a href="@imageUrl" target="_blank" rel="noreferrer" class="small text-break">@imageUrl</a>
							<button type="button" class="btn btn-sm btn-outline-danger align-self-start" @onclick="() => RemoveImage(imageUrl)" disabled="@(isSavingServiceOffer || isUploadingImage)">Remove image</button>
						</div>
					</div>
				</div>
			}
		</div>
	}

	<div class="form-check mb-3">
		<input id="serviceActive" type="checkbox" class="form-check-input" @bind="serviceActive" />
		<label for="serviceActive" class="form-check-label">Active</label>
	</div>

	<div class="d-flex gap-2">
		<button class="btn btn-primary" @onclick="SaveServiceOfferAsync" disabled="@isSavingServiceOffer">Save service offer</button>
		@if (!string.IsNullOrWhiteSpace(selectedServiceOfferId))
		{
			<button class="btn btn-outline-warning" @onclick="ToggleSelectedServiceOfferStatusAsync" disabled="@isSavingServiceOffer">@(serviceActive ? "Deactivate" : "Activate")</button>
			<button class="btn btn-outline-danger" @onclick="DeleteSelectedServiceOfferAsync" disabled="@isSavingServiceOffer">Delete</button>
		}
		<button class="btn btn-outline-secondary" @onclick="ResetServiceOfferForm">Clear form</button>
	</div>

	@if (!string.IsNullOrWhiteSpace(serviceOfferMessage))
	{
		<p class="mt-3 @serviceOfferMessageClass">@serviceOfferMessage</p>
	}

	@if (lastSavedServiceOffer is not null)
	{
		<div class="mt-3 card">
			<div class="card-body">
				<h3 class="h5 card-title">Last saved offer</h3>
				<p class="mb-1"><strong>Id:</strong> @lastSavedServiceOffer.Id</p>
				<p class="mb-1"><strong>Title:</strong> @lastSavedServiceOffer.Title</p>
				<p class="mb-0"><strong>Status:</strong> @(lastSavedServiceOffer.Active ? "Active" : "Inactive")</p>
			</div>
		</div>
	}
</section>

@if (!string.IsNullOrWhiteSpace(selectedServiceOfferId))
{
	<section class="mb-5">
		<h2 class="h4">Availability Schedule</h2>
		<p class="form-text">
			Pick the weekdays and times that repeat every week. The times apply to all selected days and stay in effect
			for all future dates until you override a specific date below. Changes are stored when you press "Save schedule".
		</p>

		@if (isLoadingSchedule)
		{
			<p>Loading schedule...</p>
		}
		else
		{
			@if (!hasStoredSchedule)
			{
				<p class="text-warning">No schedule is defined yet, so customers cannot book this service.</p>
			}

			<div class="mb-3">
				<label class="form-label">Days of week</label>
				<div class="d-flex flex-wrap gap-3">
					@foreach (var day in OrderedDaysOfWeek)
					{
						<div class="form-check">
							<input id="scheduleDay-@day" type="checkbox" class="form-check-input"
								checked="@scheduleDays.Contains(day)"
								@onchange="args => ToggleScheduleDay(day, args)" />
							<label for="scheduleDay-@day" class="form-check-label">@day</label>
						</div>
					}
				</div>
			</div>

			<div class="mb-3">
				<label for="scheduleNewTime" class="form-label">Times (applied to every selected day)</label>
				<div class="d-flex gap-2 align-items-center">
					<input id="scheduleNewTime" type="time" class="form-control" style="max-width: 10rem;" @bind="newScheduleTime" />
					<button type="button" class="btn btn-outline-primary" @onclick="AddScheduleTime" disabled="@isSavingSchedule">Add time</button>
				</div>
				@if (scheduleTimes.Count == 0)
				{
					<p class="text-muted mt-2 mb-0">No times added yet.</p>
				}
				else
				{
					<div class="d-flex flex-wrap gap-2 mt-2">
						@foreach (var time in scheduleTimes)
						{
							<span class="badge text-bg-secondary d-flex align-items-center gap-2">
								@time
								<button type="button" class="btn-close btn-close-white" aria-label="Remove @time" @onclick="() => RemoveScheduleTime(time)"></button>
							</span>
						}
					</div>
				}
			</div>

			<div class="row g-3 mb-3">
				<div class="col-sm-3">
					<label for="scheduleDuration" class="form-label">Slot duration (minutes)</label>
					<input id="scheduleDuration" type="number" min="1" class="form-control" @bind="scheduleDurationMinutes" />
				</div>
				<div class="col-sm-3">
					<label for="scheduleCapacity" class="form-label">Capacity per slot</label>
					<input id="scheduleCapacity" type="number" min="1" class="form-control" @bind="scheduleCapacity" />
				</div>
				<div class="col-sm-3">
					<label for="scheduleWindow" class="form-label">Booking window (days)</label>
					<input id="scheduleWindow" type="number" min="1" max="366" class="form-control" @bind="scheduleWindowDays" />
				</div>
				<div class="col-sm-3">
					<label for="scheduleTimeZone" class="form-label">Time zone</label>
					<input id="scheduleTimeZone" class="form-control" @bind="scheduleTimeZoneId" />
				</div>
			</div>

			<h3 class="h5">Date overrides</h3>
			<p class="form-text">Override the regular weekly times for a single date, or close it completely.</p>

			<div class="row g-3 align-items-end mb-3">
				<div class="col-sm-3">
					<label for="overrideDate" class="form-label">Date</label>
					<input id="overrideDate" type="date" class="form-control" @bind="overrideDate" @bind:after="PrefillOverrideTimes" />
				</div>
				<div class="col-sm-2">
					<div class="form-check mb-2">
						<input id="overrideClosed" type="checkbox" class="form-check-input" @bind="overrideClosed" />
						<label for="overrideClosed" class="form-check-label">Closed</label>
					</div>
				</div>
				<div class="col-sm-4">
					<label for="overrideNewTime" class="form-label">Times for this date</label>
					<div class="d-flex gap-2">
						<input id="overrideNewTime" type="time" class="form-control" style="max-width: 10rem;" @bind="newOverrideTime" disabled="@overrideClosed" />
						<button type="button" class="btn btn-outline-primary" @onclick="AddOverrideTime" disabled="@(overrideClosed || isSavingSchedule)">Add</button>
					</div>
				</div>
				<div class="col-sm-3">
					<button type="button" class="btn btn-outline-secondary" @onclick="AddOverride" disabled="@isSavingSchedule">Add override</button>
				</div>
			</div>

			@if (!overrideClosed && overrideTimes.Count > 0)
			{
				<div class="d-flex flex-wrap gap-2 mb-3">
					@foreach (var time in overrideTimes)
					{
						<span class="badge text-bg-info d-flex align-items-center gap-2">
							@time
							<button type="button" class="btn-close" aria-label="Remove @time" @onclick="() => RemoveOverrideTime(time)"></button>
						</span>
					}
				</div>
			}

			@if (scheduleOverrides.Count > 0)
			{
				<table class="table table-sm table-striped" style="max-width: 40rem;">
					<thead>
						<tr>
							<th>Date</th>
							<th>Times</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var (date, scheduleOverride) in scheduleOverrides.OrderBy(pair => pair.Key, StringComparer.Ordinal))
						{
							<tr>
								<td>@date</td>
								<td>@(scheduleOverride.Closed ? "Closed" : string.Join(", ", scheduleOverride.Times ?? []))</td>
								<td>
									<button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveOverride(date)" disabled="@isSavingSchedule">Remove override</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}

			<button class="btn btn-primary" @onclick="SaveSlotScheduleAsync" disabled="@isSavingSchedule">Save schedule</button>

			@if (!string.IsNullOrWhiteSpace(scheduleMessage))
			{
				<p class="mt-3 @scheduleMessageClass">@scheduleMessage</p>
			}
		}
	</section>
}

<section class="mb-5">
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2 class="h4 mb-0">Service Offers</h2>
		<button class="btn btn-outline-secondary" @onclick="LoadServiceOffersAsync" disabled="@isLoadingServiceOffers">Refresh</button>
	</div>

	@if (isLoadingServiceOffers)
	{
		<p>Loading service offers...</p>
	}
	else if (serviceOffers.Count == 0)
	{
		<p>No service offers found.</p>
	}
	else
	{
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Title</th>
					<th>Price</th>
					<th>Status</th>
					<th>Images</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var serviceOffer in serviceOffers)
				{
					<tr>
						<td>@serviceOffer.Title</td>
						<td>@serviceOffer.BasePrice.ToString("0.00")</td>
						<td>@(serviceOffer.Active ? "Active" : "Inactive")</td>
						<td>@serviceOffer.ImageUrls.Count</td>
						<td>
							<div class="d-flex gap-2">
								<button class="btn btn-sm btn-outline-primary" @onclick="() => EditServiceOffer(serviceOffer)">Edit</button>
								<button class="btn btn-sm @(serviceOffer.Active ? "btn-outline-warning" : "btn-outline-success")" @onclick="() => ToggleServiceOfferStatusAsync(serviceOffer)">
									@(serviceOffer.Active ? "Deactivate" : "Activate")
								</button>
								<button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteServiceOfferAsync(serviceOffer)">Delete</button>
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
</section>

<section>
	<div class="d-flex justify-content-between align-items-center mb-3">
		<h2 class="h4 mb-0">Reservations</h2>
		<div class="d-flex gap-2">
			<button class="btn btn-outline-primary" @onclick="ProcessReservationRemindersAsync" disabled="@(isLoadingReservations || isProcessingReminders)">Send due reminders</button>
			<button class="btn btn-outline-secondary" @onclick="LoadReservationsAsync" disabled="@isLoadingReservations">Refresh</button>
		</div>
	</div>

	@if (!string.IsNullOrWhiteSpace(reminderMessage))
	{
		<p class="@reminderMessageClass">@reminderMessage</p>
	}

	@if (!string.IsNullOrWhiteSpace(reservationsErrorMessage))
	{
		<p class="text-danger">@reservationsErrorMessage</p>
	}
	else if (isLoadingReservations)
	{
		<p>Loading reservations...</p>
	}
	else if (reservations.Count == 0)
	{
		<p>No reservations found.</p>
	}
	else
	{
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Created</th>
					<th>Customer</th>
					<th>Email</th>
					<th>Service</th>
					<th>Slot</th>
					<th>Confirmation</th>
					<th>Reminder</th>
					<th>Status</th>
				</tr>
				</thead>
			<tbody>
				@foreach (var reservation in reservations)
				{
					<tr>
						<td>@reservation.CreatedAtUtc.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</td>
						<td>@reservation.CustomerName</td>
						<td>@reservation.CustomerEmail</td>
						<td>@reservation.ServiceOfferId</td>
						<td>@reservation.SlotId</td>
						<td>@FormatNotificationStatus(reservation.ConfirmationSentAtUtc)</td>
						<td>@FormatNotificationStatus(reservation.ReminderSentAtUtc)</td>
						<td>@reservation.Status</td>
					</tr>
				}
			</tbody>
		</table>
	}
</section>

@code {
	private readonly List<ReservationSummaryDto> reservations = [];
	private readonly List<ServiceOfferDto> serviceOffers = [];

	private bool isLoadingReservations = true;
	private bool isLoadingServiceOffers = true;
	private bool isSavingServiceOffer;
	private bool isUploadingImage;
	private bool isProcessingReminders;
	private string? reservationsErrorMessage;
	private string? serviceOffersErrorMessage;
	private string? serviceOfferMessage;
	private string serviceOfferMessageClass = "text-success";
	private string? imageUploadMessage;
	private string imageUploadMessageClass = "text-success";
	private string? reminderMessage;
	private string reminderMessageClass = "text-success";

	private string selectedServiceOfferId = string.Empty;
	private string serviceTitle = string.Empty;
	private string serviceDescription = string.Empty;
	private decimal serviceBasePrice;
	private readonly List<string> serviceImageUrls = [];
	private bool serviceActive = true;

	private ServiceOfferDto? lastSavedServiceOffer;

	private static readonly DayOfWeek[] OrderedDaysOfWeek =
	[
		DayOfWeek.Monday,
		DayOfWeek.Tuesday,
		DayOfWeek.Wednesday,
		DayOfWeek.Thursday,
		DayOfWeek.Friday,
		DayOfWeek.Saturday,
		DayOfWeek.Sunday
	];

	private bool isLoadingSchedule;
	private bool isSavingSchedule;
	private bool hasStoredSchedule;
	private string? scheduleMessage;
	private string scheduleMessageClass = "text-success";
	private readonly HashSet<DayOfWeek> scheduleDays = [];
	private readonly List<string> scheduleTimes = [];
	private TimeOnly? newScheduleTime;
	private int scheduleDurationMinutes = 60;
	private int scheduleCapacity = 1;
	private int scheduleWindowDays = 28;
	private string scheduleTimeZoneId = "Europe/Prague";
	private readonly Dictionary<string, SlotScheduleOverrideDto> scheduleOverrides = [];
	private DateOnly? overrideDate;
	private bool overrideClosed;
	private readonly List<string> overrideTimes = [];
	private TimeOnly? newOverrideTime;

	protected override async Task OnInitializedAsync()
	{
		await LoadServiceOffersAsync();
		await LoadReservationsAsync();
	}

	private async Task LoadServiceOffersAsync()
	{
		isLoadingServiceOffers = true;
		serviceOffersErrorMessage = null;

		try
		{
			var loadedServiceOffers = await AdminApiClient.GetServiceOffersAsync(CancellationToken.None);
			serviceOffers.Clear();
			serviceOffers.AddRange(loadedServiceOffers.OrderBy(serviceOffer => serviceOffer.Title, StringComparer.OrdinalIgnoreCase));

			if (!string.IsNullOrWhiteSpace(selectedServiceOfferId))
			{
				var selectedServiceOffer = serviceOffers.FirstOrDefault(serviceOffer => serviceOffer.Id == selectedServiceOfferId);
				if (selectedServiceOffer is null)
				{
					ResetServiceOfferForm();
				}
				else
				{
					PopulateServiceOfferForm(selectedServiceOffer);
				}
			}
		}
		catch
		{
			serviceOffersErrorMessage = "Failed to load service offers.";
		}
		finally
		{
			isLoadingServiceOffers = false;
		}
	}

	private async Task LoadReservationsAsync()
	{
		isLoadingReservations = true;
		reservationsErrorMessage = null;

		try
		{
			var loadedReservations = await AdminApiClient.GetReservationsAsync(CancellationToken.None);
			reservations.Clear();
			reservations.AddRange(loadedReservations);
		}
		catch
		{
			reservationsErrorMessage = "Failed to load reservations.";
		}
		finally
		{
			isLoadingReservations = false;
		}
	}

	private async Task ProcessReservationRemindersAsync()
	{
		reminderMessage = null;
		isProcessingReminders = true;

		try
		{
			var result = await AdminApiClient.ProcessReservationRemindersAsync(CancellationToken.None);
			await LoadReservationsAsync();
			reminderMessageClass = result is not null && result.FailedCount > 0 ? "text-warning" : "text-success";
			reminderMessage = result is null
				? "Reminder processing completed with no payload."
				: $"Processed {result.ProcessedCount} reminder candidates. Sent {result.SentCount}, failed {result.FailedCount}.";
		}
		catch
		{
			reminderMessageClass = "text-danger";
			reminderMessage = "Failed to process reminders.";
		}
		finally
		{
			isProcessingReminders = false;
		}
	}

	private async Task SaveServiceOfferAsync()
	{
		serviceOfferMessage = null;

		if (string.IsNullOrWhiteSpace(serviceTitle) || string.IsNullOrWhiteSpace(serviceDescription))
		{
			serviceOfferMessageClass = "text-danger";
			serviceOfferMessage = "Title and description are required.";
			return;
		}

		isSavingServiceOffer = true;

		try
		{
			var request = new UpsertServiceOfferRequestDto(
				string.IsNullOrWhiteSpace(selectedServiceOfferId) ? null : selectedServiceOfferId,
				serviceTitle,
				serviceDescription,
				serviceBasePrice,
				serviceImageUrls.ToArray(),
				serviceActive);

			var isNewServiceOffer = string.IsNullOrWhiteSpace(selectedServiceOfferId);
			lastSavedServiceOffer = await AdminApiClient.UpsertServiceOfferAsync(request, CancellationToken.None);
			if (lastSavedServiceOffer is not null)
			{
				selectedServiceOfferId = lastSavedServiceOffer.Id;
				PopulateServiceOfferForm(lastSavedServiceOffer);
				if (isNewServiceOffer)
				{
					await LoadSlotScheduleAsync();
				}
			}

			await LoadServiceOffersAsync();
			serviceOfferMessageClass = "text-success";
			serviceOfferMessage = lastSavedServiceOffer is null
				? "Service offer request completed with no payload."
				: "Service offer saved.";
		}
		catch
		{
			serviceOfferMessageClass = "text-danger";
			serviceOfferMessage = "Failed to save service offer.";
		}
		finally
		{
			isSavingServiceOffer = false;
		}
	}

	private async Task ToggleSelectedServiceOfferStatusAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedServiceOfferId))
		{
			return;
		}

		var selectedServiceOffer = serviceOffers.FirstOrDefault(serviceOffer => serviceOffer.Id == selectedServiceOfferId);
		if (selectedServiceOffer is null)
		{
			return;
		}

		await ToggleServiceOfferStatusAsync(selectedServiceOffer);
	}

	private async Task DeleteSelectedServiceOfferAsync()
	{
		if (string.IsNullOrWhiteSpace(selectedServiceOfferId))
		{
			return;
		}

		var selectedServiceOffer = serviceOffers.FirstOrDefault(serviceOffer => serviceOffer.Id == selectedServiceOfferId);
		if (selectedServiceOffer is null)
		{
			return;
		}

		await DeleteServiceOfferAsync(selectedServiceOffer);
	}

	private async Task ToggleServiceOfferStatusAsync(ServiceOfferDto serviceOffer)
	{
		serviceOfferMessage = null;
		isSavingServiceOffer = true;

		try
		{
			lastSavedServiceOffer = await AdminApiClient.UpsertServiceOfferAsync(
				new UpsertServiceOfferRequestDto(
					serviceOffer.Id,
					serviceOffer.Title,
					serviceOffer.Description,
					serviceOffer.BasePrice,
					serviceOffer.ImageUrls,
					!serviceOffer.Active),
				CancellationToken.None);

			if (lastSavedServiceOffer is not null)
			{
				selectedServiceOfferId = lastSavedServiceOffer.Id;
				PopulateServiceOfferForm(lastSavedServiceOffer);
			}

			await LoadServiceOffersAsync();
			serviceOfferMessageClass = "text-success";
			serviceOfferMessage = serviceOffer.Active ? "Service offer deactivated." : "Service offer activated.";
		}
		catch
		{
			serviceOfferMessageClass = "text-danger";
			serviceOfferMessage = serviceOffer.Active ? "Failed to deactivate service offer." : "Failed to activate service offer.";
		}
		finally
		{
			isSavingServiceOffer = false;
		}
	}

	private async Task UploadImageAsync(InputFileChangeEventArgs args)
	{
		imageUploadMessage = null;
		var file = args.File;
		if (file is null)
		{
			return;
		}

		isUploadingImage = true;

		try
		{
			var uploadedImage = await AdminApiClient.UploadServiceOfferImageAsync(file, CancellationToken.None);
			if (uploadedImage is null)
			{
				imageUploadMessageClass = "text-danger";
				imageUploadMessage = "Image upload returned no payload.";
				return;
			}

			if (!serviceImageUrls.Contains(uploadedImage.Url, StringComparer.OrdinalIgnoreCase))
			{
				serviceImageUrls.Add(uploadedImage.Url);
			}

			imageUploadMessageClass = "text-success";
			imageUploadMessage = $"Uploaded '{uploadedImage.FileName}'.";
		}
		catch
		{
			imageUploadMessageClass = "text-danger";
			imageUploadMessage = "Failed to upload image.";
		}
		finally
		{
			isUploadingImage = false;
		}
	}

	private async Task DeleteServiceOfferAsync(ServiceOfferDto serviceOffer)
	{
		serviceOfferMessage = null;
		isSavingServiceOffer = true;

		try
		{
			var error = await AdminApiClient.DeleteServiceOfferAsync(serviceOffer.Id, CancellationToken.None);
			if (error is not null)
			{
				serviceOfferMessageClass = "text-danger";
				serviceOfferMessage = error.Message;
				return;
			}

			if (string.Equals(selectedServiceOfferId, serviceOffer.Id, StringComparison.Ordinal))
			{
				ResetServiceOfferForm();
				lastSavedServiceOffer = null;
			}

			await LoadServiceOffersAsync();
			serviceOfferMessageClass = "text-success";
			serviceOfferMessage = "Service offer deleted.";
		}
		catch
		{
			serviceOfferMessageClass = "text-danger";
			serviceOfferMessage = "Failed to delete service offer.";
		}
		finally
		{
			isSavingServiceOffer = false;
		}
	}

	private async Task OnSelectedServiceOfferChangedAsync()
	{
		var selectedServiceOffer = serviceOffers.FirstOrDefault(serviceOffer => serviceOffer.Id == selectedServiceOfferId);
		if (selectedServiceOffer is null)
		{
			ResetServiceOfferForm();
			return;
		}

		PopulateServiceOfferForm(selectedServiceOffer);
		await LoadSlotScheduleAsync();
	}

	private async Task EditServiceOffer(ServiceOfferDto serviceOffer)
	{
		selectedServiceOfferId = serviceOffer.Id;
		PopulateServiceOfferForm(serviceOffer);
		await LoadSlotScheduleAsync();
	}

	private async Task LoadSlotScheduleAsync()
	{
		ResetScheduleForm();
		if (string.IsNullOrWhiteSpace(selectedServiceOfferId))
		{
			return;
		}

		isLoadingSchedule = true;

		try
		{
			var schedule = await AdminApiClient.GetSlotScheduleAsync(selectedServiceOfferId, CancellationToken.None);
			if (schedule is not null)
			{
				hasStoredSchedule = true;
				scheduleDays.UnionWith(schedule.DaysOfWeek);
				scheduleTimes.AddRange(schedule.Times);
				scheduleDurationMinutes = schedule.SlotDurationMinutes;
				scheduleCapacity = schedule.Capacity;
				scheduleWindowDays = schedule.BookingWindowDays;
				scheduleTimeZoneId = schedule.TimeZoneId;
				foreach (var (date, scheduleOverride) in schedule.Overrides)
				{
					scheduleOverrides[date] = scheduleOverride;
				}
			}
		}
		catch
		{
			scheduleMessageClass = "text-danger";
			scheduleMessage = "Failed to load the slot schedule.";
		}
		finally
		{
			isLoadingSchedule = false;
		}
	}

	private async Task SaveSlotScheduleAsync()
	{
		scheduleMessage = null;

		if (scheduleDays.Count == 0 || scheduleTimes.Count == 0)
		{
			scheduleMessageClass = "text-danger";
			scheduleMessage = "Select at least one day and add at least one time.";
			return;
		}

		isSavingSchedule = true;

		try
		{
			var saved = await AdminApiClient.UpsertSlotScheduleAsync(
				new SlotScheduleDto(
					selectedServiceOfferId,
					scheduleDays.OrderBy(day => day).ToArray(),
					scheduleTimes.ToArray(),
					scheduleDurationMinutes,
					scheduleCapacity,
					scheduleWindowDays,
					scheduleTimeZoneId.Trim(),
					new Dictionary<string, SlotScheduleOverrideDto>(scheduleOverrides)),
				CancellationToken.None);

			if (saved is not null)
			{
				hasStoredSchedule = true;
				scheduleDays.Clear();
				scheduleDays.UnionWith(saved.DaysOfWeek);
				scheduleTimes.Clear();
				scheduleTimes.AddRange(saved.Times);
				scheduleOverrides.Clear();
				foreach (var (date, scheduleOverride) in saved.Overrides)
				{
					scheduleOverrides[date] = scheduleOverride;
				}
			}

			scheduleMessageClass = "text-success";
			scheduleMessage = "Schedule saved.";
		}
		catch
		{
			scheduleMessageClass = "text-danger";
			scheduleMessage = "Failed to save the schedule.";
		}
		finally
		{
			isSavingSchedule = false;
		}
	}

	private void ToggleScheduleDay(DayOfWeek day, ChangeEventArgs args)
	{
		if (args.Value is bool selected && selected)
		{
			scheduleDays.Add(day);
		}
		else
		{
			scheduleDays.Remove(day);
		}
	}

	private void AddScheduleTime()
	{
		if (newScheduleTime is { } time)
		{
			var normalized = FormatTime(time);
			if (!scheduleTimes.Contains(normalized, StringComparer.Ordinal))
			{
				scheduleTimes.Add(normalized);
				scheduleTimes.Sort(StringComparer.Ordinal);
			}
		}

		newScheduleTime = null;
	}

	private void RemoveScheduleTime(string time)
	{
		scheduleTimes.RemoveAll(candidate => string.Equals(candidate, time, StringComparison.Ordinal));
	}

	private void PrefillOverrideTimes()
	{
		overrideTimes.Clear();
		if (overrideClosed || overrideDate is not { } date)
		{
			return;
		}

		var dateKey = FormatDate(date);
		if (scheduleOverrides.TryGetValue(dateKey, out var existingOverride))
		{
			overrideClosed = existingOverride.Closed;
			overrideTimes.AddRange(existingOverride.Times ?? []);
			return;
		}

		if (scheduleDays.Contains(date.DayOfWeek))
		{
			overrideTimes.AddRange(scheduleTimes);
		}
	}

	private void AddOverrideTime()
	{
		if (newOverrideTime is { } time)
		{
			var normalized = FormatTime(time);
			if (!overrideTimes.Contains(normalized, StringComparer.Ordinal))
			{
				overrideTimes.Add(normalized);
				overrideTimes.Sort(StringComparer.Ordinal);
			}
		}

		newOverrideTime = null;
	}

	private void RemoveOverrideTime(string time)
	{
		overrideTimes.RemoveAll(candidate => string.Equals(candidate, time, StringComparison.Ordinal));
	}

	private void AddOverride()
	{
		scheduleMessage = null;

		if (overrideDate is not { } date)
		{
			scheduleMessageClass = "text-danger";
			scheduleMessage = "Pick a valid override date.";
			return;
		}

		var dateKey = FormatDate(date);
		scheduleOverrides[dateKey] = new SlotScheduleOverrideDto(
			overrideClosed,
			overrideClosed ? null : overrideTimes.ToArray());

		overrideDate = null;
		overrideClosed = false;
		overrideTimes.Clear();
		scheduleMessageClass = "text-warning";
		scheduleMessage = "Override added. Press \"Save schedule\" to store the changes.";
	}

	private void RemoveOverride(string date)
	{
		scheduleOverrides.Remove(date);
		scheduleMessageClass = "text-warning";
		scheduleMessage = "Override removed. Press \"Save schedule\" to store the changes.";
	}

	private void ResetScheduleForm()
	{
		hasStoredSchedule = false;
		scheduleMessage = null;
		scheduleDays.Clear();
		scheduleTimes.Clear();
		newScheduleTime = null;
		scheduleDurationMinutes = 60;
		scheduleCapacity = 1;
		scheduleWindowDays = 28;
		scheduleTimeZoneId = "Europe/Prague";
		scheduleOverrides.Clear();
		overrideDate = null;
		overrideClosed = false;
		overrideTimes.Clear();
		newOverrideTime = null;
	}

	private static string FormatTime(TimeOnly time)
	{
		return time.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture);
	}

	private static string FormatDate(DateOnly date)
	{
		return date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
	}

	private void PopulateServiceOfferForm(ServiceOfferDto serviceOffer)
	{
		selectedServiceOfferId = serviceOffer.Id;
		serviceTitle = serviceOffer.Title;
		serviceDescription = serviceOffer.Description;
		serviceBasePrice = serviceOffer.BasePrice;
		serviceImageUrls.Clear();
		serviceImageUrls.AddRange(serviceOffer.ImageUrls);
		serviceActive = serviceOffer.Active;
	}

	private void ResetServiceOfferForm()
	{
		selectedServiceOfferId = string.Empty;
		serviceTitle = string.Empty;
		serviceDescription = string.Empty;
		serviceBasePrice = 0;
		serviceImageUrls.Clear();
		serviceActive = true;
		imageUploadMessage = null;
		ResetScheduleForm();
	}

	private void RemoveImage(string imageUrl)
	{
		serviceImageUrls.RemoveAll(url => string.Equals(url, imageUrl, StringComparison.OrdinalIgnoreCase));
	}

	private static string FormatNotificationStatus(DateTimeOffset? sentAtUtc)
	{
		return sentAtUtc is null
			? "Pending"
			: sentAtUtc.Value.LocalDateTime.ToString("yyyy-MM-dd HH:mm");
	}
}