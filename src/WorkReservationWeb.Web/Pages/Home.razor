@page "/"
@inject WorkReservationWeb.Web.Services.ReservationPublicApiClient ApiClient
@using WorkReservationWeb.Shared.Contracts

<PageTitle>WorkReservation — Book an Appointment</PageTitle>

<section class="wr-hero">
	<h1>Book your appointment online</h1>
	<p>Choose a service, pick a time that suits you, and get an instant confirmation — no phone calls needed.</p>
</section>

@if (isLoading)
{
	<p>Loading services...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
	<div class="alert alert-danger">@errorMessage</div>
}
else
{
	<div class="wr-section-card">
		<div class="d-flex justify-content-between align-items-baseline mb-3">
			<h2 class="wr-section-title">1. Choose a service</h2>
		</div>

		<div class="row g-3">
			@foreach (var service in services)
			{
				<div class="col-sm-6 col-lg-4">
					<div class="service-card @(service.Id == selectedServiceId ? "selected" : null)"
						 data-service-id="@service.Id"
						 role="button"
						 @onclick="() => SelectServiceAsync(service.Id)">
						<img src="@GetServiceImageUrl(service)" alt="@service.Title" loading="lazy"
							 onerror="this.onerror=null;this.src='images/service-placeholder.svg';" />
						<div class="service-card-body">
							<div class="service-card-title">
								<span>@service.Title</span>
								<span class="service-card-price">@service.BasePrice.ToString("0.00")</span>
							</div>
							@if (!string.IsNullOrWhiteSpace(service.Description))
							{
								<p class="service-card-description">@service.Description</p>
							}
						</div>
					</div>
				</div>
			}
		</div>
	</div>

	<div class="wr-section-card">
		<h2 class="wr-section-title mb-3">2. Pick a time</h2>

		@if (slots.Count == 0)
		{
			<p class="text-muted mb-0">No available slots for this service.</p>
		}
		else
		{
			<div class="slot-scroll">
				@foreach (var day in slots.GroupBy(slot => slot.StartUtc.LocalDateTime.Date))
				{
					<div class="slot-day">
						<div class="slot-day-label">@day.Key.ToString("ddd d MMM yyyy")</div>
						<div class="d-flex flex-wrap gap-2">
							@foreach (var slot in day)
							{
								<button type="button"
										class="slot-chip @(slot.Id == selectedSlotId ? "selected" : null)"
										data-slot-id="@slot.Id"
										@onclick="() => selectedSlotId = slot.Id">
									@slot.StartUtc.LocalDateTime.ToString("HH:mm")
									<span class="slot-chip-capacity">(@slot.ReservedCount/@slot.Capacity)</span>
								</button>
							}
						</div>
					</div>
				}
			</div>
		}
	</div>

	<div class="wr-section-card">
		<h2 class="wr-section-title mb-3">3. Your details</h2>

		<div class="row g-3">
			<div class="col-md-6">
				<label for="customerName" class="form-label">Name</label>
				<input id="customerName" class="form-control" @bind="customerName" autocomplete="name" />
			</div>

			<div class="col-md-6">
				<label for="customerEmail" class="form-label">Email</label>
				<input id="customerEmail" type="email" class="form-control" @bind="customerEmail" autocomplete="email" />
			</div>

			<div class="col-12">
				<label for="note" class="form-label">Note (optional)</label>
				<textarea id="note" class="form-control" rows="3" @bind="note"></textarea>
			</div>
		</div>

		<div class="mt-4 d-flex align-items-center gap-3 flex-wrap">
			<button class="btn btn-primary btn-lg px-4" @onclick="SubmitAsync" disabled="@isSubmitting">Book now</button>
			@if (selectedSlot is not null)
			{
				<span class="text-muted">
					@selectedService?.Title — @selectedSlot.StartUtc.LocalDateTime.ToString("ddd d MMM yyyy HH:mm")
				</span>
			}
		</div>

		@if (!string.IsNullOrWhiteSpace(resultMessage))
		{
			<div class="alert @resultClass mt-3 mb-0" role="alert">@resultMessage</div>
		}
	</div>
}

@code {
	private readonly List<ServiceOfferDto> services = [];
	private readonly List<ReservationSlotDto> slots = [];

	private bool isLoading = true;
	private bool isSubmitting;
	private string? errorMessage;
	private string? resultMessage;
	private string resultClass = "alert-success";

	private string selectedServiceId = string.Empty;
	private string selectedSlotId = string.Empty;

	private string customerName = string.Empty;
	private string customerEmail = string.Empty;
	private string? note;

	private ServiceOfferDto? selectedService => services.FirstOrDefault(x => x.Id == selectedServiceId);
	private ReservationSlotDto? selectedSlot => slots.FirstOrDefault(x => x.Id == selectedSlotId);

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var loadedServices = await ApiClient.GetServicesAsync(CancellationToken.None);
			services.AddRange(loadedServices);

			if (services.Count > 0)
			{
				selectedServiceId = services[0].Id;
				await LoadSlotsAsync();
			}
			else
			{
				errorMessage = "No active services are available.";
			}
		}
		catch
		{
			errorMessage = "Failed to load reservation data.";
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task SelectServiceAsync(string serviceId)
	{
		if (string.Equals(selectedServiceId, serviceId, StringComparison.Ordinal))
		{
			return;
		}

		selectedServiceId = serviceId;
		resultMessage = null;
		await LoadSlotsAsync();
	}

	private async Task LoadSlotsAsync()
	{
		slots.Clear();

		if (string.IsNullOrWhiteSpace(selectedServiceId))
		{
			return;
		}

		var loadedSlots = await ApiClient.GetSlotsAsync(selectedServiceId, CancellationToken.None);
		slots.AddRange(loadedSlots);
		selectedSlotId = slots.FirstOrDefault()?.Id ?? string.Empty;
	}

	private static string GetServiceImageUrl(ServiceOfferDto service)
	{
		return service.ImageUrls.FirstOrDefault(url => !string.IsNullOrWhiteSpace(url))
			?? "images/service-placeholder.svg";
	}

	private async Task SubmitAsync()
	{
		resultMessage = null;

		if (string.IsNullOrWhiteSpace(customerName) || string.IsNullOrWhiteSpace(customerEmail))
		{
			resultClass = "alert-danger";
			resultMessage = "Name and email are required.";
			return;
		}

		var slotToBook = selectedSlot;
		if (slotToBook is null)
		{
			resultClass = "alert-danger";
			resultMessage = "Please select an available slot.";
			return;
		}

		isSubmitting = true;

		try
		{
			var request = new CreateReservationRequestDto(
				selectedServiceId,
				slotToBook.Id,
				slotToBook.Etag,
				customerName,
				customerEmail,
				note);

			var result = await ApiClient.CreateReservationAsync(request, CancellationToken.None);
			if (result is null)
			{
				resultClass = "alert-danger";
				resultMessage = "Booking failed unexpectedly.";
				return;
			}

			resultClass = result.Success ? "alert-success" : "alert-danger";
			resultMessage = result.Message;

			await LoadSlotsAsync();
		}
		finally
		{
			isSubmitting = false;
		}
	}
}
