{
  "platform": {
    "apiRuntime": "dotnet-isolated:9.0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/_framework/*",
      "/css/*",
      "/lib/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,json,js,wasm,dat,br,gz,woff,woff2,txt}"
    ]
  },
  "routes": [
    {
      "route": "/admin",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/management/*",
      "allowedRoles": ["admin"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  }
}
